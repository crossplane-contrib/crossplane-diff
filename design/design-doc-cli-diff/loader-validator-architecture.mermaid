classDiagram
    note "Loaders come from upstream crossplane/cli cmd/crossplane/common/load"

    class Loader {
        <<interface>>
        +Load() ([]*Unstructured, error)
    }

    class CompositeLoader {
        -loaders []Loader
        +Load() ([]*Unstructured, error)
    }

    class MultiLoader {
        -loaders []Loader
        +Load() ([]*Unstructured, error)
    }

    class FileLoader {
        -path string
        +Load() ([]*Unstructured, error)
    }

    class StdinLoader {
        +Load() ([]*Unstructured, error)
    }

    class FolderLoader {
        -path string
        +Load() ([]*Unstructured, error)
    }

    class YamlStream {
        <<function>>
        +YamlStream(reader) ([][]byte, error)
    }

    class streamToUnstructured {
        <<function>>
        +streamToUnstructured(stream) ([]*Unstructured, error)
    }

    class SchemaValidator {
        <<interface>>
        +ValidateResources(ctx, xr, composed) error
        +EnsureComposedResourceCRDs(ctx, resources) error
        +ValidateScopeConstraints(ctx, resource, ns, isClaimRoot) error
    }

    class DefaultSchemaValidator {
        -defClient DefinitionClient
        -schemaClient SchemaClient
        -resourceClient ResourceClient
        -logger logging.Logger
        +ValidateResources(ctx, xr, composed) error
        +EnsureComposedResourceCRDs(ctx, resources) error
        +ValidateScopeConstraints(ctx, resource, ns, isClaimRoot) error
    }

    class ResolveResourceScope {
        <<function>>
        +resolveResourceScope(ctx, rc, sc, logger, gvk) (extv1.ResourceScope, error)
    }

    class SchemaValidate {
        <<function>>
        +pkgvalidate.SchemaValidate(ctx, resources, crds) (*ValidationResult, error)
    }

    CompositeLoader ..|> Loader
    MultiLoader ..|> Loader
    FileLoader ..|> Loader
    StdinLoader ..|> Loader
    FolderLoader ..|> Loader

    %% NewCompositeLoader builds one loader per source with NewLoader, which
    %% returns a MultiLoader for a comma-separated source.
    CompositeLoader --> Loader
    MultiLoader --> Loader

    FileLoader --> YamlStream
    StdinLoader --> YamlStream
    FolderLoader --> YamlStream

    FileLoader --> streamToUnstructured
    StdinLoader --> streamToUnstructured
    FolderLoader --> streamToUnstructured

    DefaultSchemaValidator ..|> SchemaValidator
    DefaultSchemaValidator --> SchemaValidate
    DefaultSchemaValidator --> ResolveResourceScope
