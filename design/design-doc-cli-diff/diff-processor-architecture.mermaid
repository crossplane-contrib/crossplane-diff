classDiagram
    class DiffProcessor {
        <<interface>>
        +PerformDiff(ctx, resources, compositionProvider) (*XRReport, error)
        +DiffSingleResource(ctx, res, compositionProvider) (map[string]*ResourceDiff, error)
        +Initialize(ctx) error
        +Cleanup(ctx) error
    }

    class CompDiffProcessor {
        <<interface>>
        +DiffComposition(ctx, comps, namespace, resources) (*CompDiffOutput, error)
        +Initialize(ctx) error
        +Cleanup(ctx) error
    }

    class DefaultDiffProcessor {
        -fnProvider FunctionProvider
        -compClient CompositionClient
        -defClient DefinitionClient
        -schemaClient SchemaClient
        -treeClient ResourceTreeClient
        -applyClient ApplyClient
        -config ProcessorConfig
        -schemaValidator SchemaValidator
        -compositeResolver CompositeResolver
        -renderDefaulter Defaulter
        -diffCalculator DiffCalculator
        -requirementsProvider RequirementsProvider
        +Initialize(ctx) error
        +Cleanup(ctx) error
        +PerformDiff(ctx, resources, compositionProvider) (*XRReport, error)
        +DiffSingleResource(ctx, res, compositionProvider) (map[string]*ResourceDiff, error)
        +RenderToStableState(ctx, xr, comp, fns, id, observed, synthReady) (render.CompositionOutputs, error)
    }

    class DefaultCompDiffProcessor {
        -compositionClient CompositionClient
        -config ProcessorConfig
        -xrProc DiffProcessor
        +DiffComposition(ctx, comps, ns, resources) (*CompDiffOutput, error)
    }

    class ProcessorConfig {
        +MaxNestedDepth int
        +MaxRenderIterations int
        +IncludeManual bool
        +EventualState bool
        +AnalyzeOn AnalyzeOn
        +IgnorePaths []string
        +FunctionCredentials []corev1.Secret
        +FunctionRegistryOverride string
        +CrossplaneRenderBinary string
        +CrossplaneVersion string
        +CrossplaneImage string
        +Logger logging.Logger
        +Advisories *AdvisoryCollector
        +RenderFunc RenderFn
        +Factories ComponentFactories
    }

    class ComponentFactories {
        +ResourceManager
        +SchemaValidator
        +Defaulter
        +DiffCalculator
        +RequirementsProvider
        +FunctionProvider
        +InputValidator
    }

    class SchemaValidator {
        <<interface>>
        +ValidateResources(ctx, xr, composed) error
        +EnsureComposedResourceCRDs(ctx, resources) error
        +ValidateScopeConstraints(ctx, resource, ns, isClaimRoot) error
    }

    class Defaulter {
        <<interface>>
        +Default(ctx, obj) (*Unstructured, storageVersion string, error)
    }

    class DiffCalculator {
        <<interface>>
        +CalculateDiff(ctx, composite, desired) (*ResourceDiff, error)
        +CalculateDiffs(ctx, xr, desired) (map[string]*ResourceDiff, error)
        +CalculateNonRemovalDiffs(ctx, xr, desired) (map[string]*ResourceDiff, RenderedResources, error)
        +CalculateRemovedResourceDiffs(ctx, xr, rendered) (map[string]*ResourceDiff, error)
    }

    class ResourceManager {
        <<interface>>
        +FetchCurrentObject(ctx, composite, desired) (*Unstructured, bool, error)
        +UpdateOwnerRefs(ctx, parent, child)
        +FetchObservedResources(ctx, xr) ([]Unstructured, error)
    }

    class CompositeResolver {
        +Resolve(ctx, authored, existing) (EffectiveComposite, error)
    }

    class FunctionProvider {
        <<interface>>
        +GetFunctionsForComposition(ctx, comp) ([]Function, error)
        +Cleanup(ctx) error
    }

    class InputValidator {
        <<interface>>
        +ToRender() []ValidatedInput
        +RecordRender(i, rendered, err)
        +Verdicts(groups) []error
        +RenderOverlaps(groups) []error
    }

    class RequirementsProvider {
        -client ResourceClient
        -envClient EnvironmentClient
        -logger logging.Logger
        -resourceCache map
        -cacheMutex sync.RWMutex
        +Initialize(ctx) error
        +ResolveSelectors(ctx, selectors, ns) ([]Unstructured, error)
        +ClearCache()
    }

    class XRReport {
        +Groups []XRDiffGroup
        +Errors []OutputError
        +Warnings []OutputWarning
        +HasChanges() bool
    }

    class CompDiffOutput {
        +Compositions []CompositionDiff
        +Errors []OutputError
        +Warnings []OutputWarning
        +HasChanges() bool
    }

    DefaultDiffProcessor ..|> DiffProcessor
    DefaultCompDiffProcessor ..|> CompDiffProcessor
    DefaultCompDiffProcessor --> DiffProcessor : xrProc field
    DefaultDiffProcessor --> ProcessorConfig
    DefaultDiffProcessor --> SchemaValidator
    DefaultDiffProcessor --> DiffCalculator
    DefaultDiffProcessor --> Defaulter : strict, render input
    DefaultDiffProcessor --> ResourceManager
    DefaultDiffProcessor --> CompositeResolver : effective composite
    CompositeResolver --> ResourceManager
    DefaultDiffProcessor --> RequirementsProvider
    DefaultDiffProcessor --> FunctionProvider
    DefaultDiffProcessor --> InputValidator : one per PerformDiff
    DefaultDiffProcessor ..> XRReport : returns
    DefaultCompDiffProcessor ..> CompDiffOutput : returns

    ProcessorConfig --> ComponentFactories

    class compare {
        <<package>>
        +GenerateDiff(ctx, current, desired, logger, Options) (*ResourceDiff, error)
    }

    DiffCalculator --> compare : cleanup, ignore paths, line diff
    DiffCalculator --> ResourceManager
    DiffCalculator --> Defaulter : lenient, additions without a dry run
