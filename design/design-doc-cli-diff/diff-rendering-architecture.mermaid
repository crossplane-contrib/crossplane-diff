classDiagram
    class DiffRenderer {
        <<interface>>
        +RenderDiffs(groups, errs, warnings) error
    }

    class CompDiffRenderer {
        <<interface>>
        +RenderCompDiff(output) error
    }

    class DefaultDiffRenderer {
        -logger logging.Logger
        -diffOpts DiffOptions
        +RenderDiffs(groups, errs, warnings) error
    }

    class StructuredDiffRenderer {
        -logger logging.Logger
        -opts DiffOptions
        +RenderDiffs(groups, errs, warnings) error
    }

    class DefaultCompDiffRenderer {
        -logger logging.Logger
        -diffRenderer DiffRenderer
        -opts DiffOptions
        +RenderCompDiff(output) error
    }

    class StructuredCompDiffRenderer {
        -logger logging.Logger
        -opts DiffOptions
        +RenderCompDiff(output) error
    }

    class dryRunWarnings {
        <<function>>
        +dryRunWarnings(diffSets) []OutputWarning
        one per GVK + namespace + reason + detail, with count
    }

    class XRDiffGroup {
        +XR ObjectReference
        +NameGenerated bool
        +Diffs map[string]*ResourceDiff
        +Err *OutputError
        +DroppedUnverified map[string]*ResourceDiff
    }

    class OutputFormat {
        <<enumeration>>
        OutputFormatDiff
        OutputFormatJSON
        OutputFormatYAML
    }

    class DiffOptions {
        +Stdout io.Writer
        +Stderr io.Writer
        +Format OutputFormat
        +UseColors bool
        +AddPrefix string
        +DeletePrefix string
        +ContextPrefix string
        +ContextLines int
        +ChunkSeparator string
        +Compact bool
        +IgnorePaths []string
        +ForVerdict bool
        +MinimizeComposition bool
        +SeededRevisionRef bool
    }

    class StructuredDiffOutput {
        +Summary Summary
        +Changes []ChangeDetail (deprecated)
        +Errors []OutputError
        +Warnings []OutputWarning
        +Xrs []xrDiffWire
    }

    class xrDiffWire {
        +XR ObjectReference
        +Status XRStatus
        +Summary Summary
        +Changes []ChangeDetail
        +Errors []OutputError
    }


    class Summary {
        +Added int
        +Modified int
        +Removed int
    }

    class ChangeDetail {
        +Type string
        +APIVersion string
        +Kind string
        +Name string
        +Namespace string
        +Diff map[string]any
        +DryRun *DryRunInfo
    }

    class CompDiffOutput {
        +Compositions []CompositionDiff
        +Errors []OutputError
        +Warnings []OutputWarning
    }

    class CompositionDiff {
        +Name string
        +Error error
        +CompositionDiff *ResourceDiff
        +AffectedResources AffectedResourcesSummary
        +ImpactAnalysis []XRImpact
        +ImpactAnalysisSkipped bool
        +MaskedChangesOnly bool
        +RevisionImpact RevisionImpact
    }

    class RevisionImpact {
        +ChangeScope string
        +CreatesRevision bool
        +RepointedComposites int
        +PredictedRevisionName string
    }

    class XRImpact {
        +ObjectReference
        +Status XRStatus
        +FilterReason FilterReason
        +FilterDetail string
        +Error error
        +Diffs map[string]*ResourceDiff
        +DroppedUnverified map[string]*ResourceDiff
    }

    class XRStatus {
        <<enumeration>>
        XRStatusChanged
        XRStatusUnchanged
        XRStatusError
        XRStatusFiltered
    }

    class FilterReason {
        <<enumeration>>
        FilterReasonManualPolicy
        FilterReasonRevisionSelectorMismatch
        FilterReasonDeleting
    }

    class AffectedResourcesSummary {
        +Total int
        +WithChanges int
        +Unchanged int
        +WithErrors int
        +FilteredByPolicy int
        +FilteredBySelector int
        +FilteredByDeletion int
    }

    class DownstreamChanges {
        +Summary Summary
        +Changes []ChangeDetail
    }

    class OutputWarning {
        +Message string
        +Context map[string]string
        +FormatWarning() string
    }

    class OutputError {
        +ResourceID string
        +Message string
        +ValidationFailures []ResourceValidationFailure
    }

    class ResourceValidationFailure {
        +APIVersion string
        +Kind string
        +Name string
        +Namespace string
        +Status string
        +Errors []FieldValidationError
    }

    class FieldValidationError {
        +Type string
        +Field string
        +Message string
        +Value any
    }

    class ResourceDiff {
        +Gvk GroupVersionKind
        +Namespace string
        +ResourceName string
        +DiffType DiffType
        +LineDiffs []diffmatchpatch.Diff
        +Current *Unstructured
        +Desired *Unstructured
        +DryRun *DryRunInfo
        +GetDiffKey() string
    }

    class DiffType {
        <<enumeration>>
        DiffTypeAdded
        DiffTypeRemoved
        DiffTypeModified
        DiffTypeEqual
    }

    class DryRunInfo {
        +Performed bool
        +SkipReason DryRunSkipReason
        +Detail string
    }

    class DryRunSkipReason {
        <<enumeration>>
        DryRunSkipDisabled
        DryRunSkipForbidden
        DryRunSkipWebhookUnavailable
        DryRunSkipNamespaceNotFound
    }

    DefaultDiffRenderer ..|> DiffRenderer
    StructuredDiffRenderer ..|> DiffRenderer
    DefaultCompDiffRenderer ..|> CompDiffRenderer
    StructuredCompDiffRenderer ..|> CompDiffRenderer

    DefaultDiffRenderer --> DiffOptions
    DefaultDiffRenderer ..> ResourceDiff
    StructuredDiffRenderer --> StructuredDiffOutput
    StructuredCompDiffRenderer --> CompDiffOutput
    DefaultCompDiffRenderer --> DiffRenderer

    DiffRenderer ..> XRDiffGroup
    XRDiffGroup --> ResourceDiff
    XRDiffGroup --> OutputError
    DefaultDiffRenderer ..> dryRunWarnings
    StructuredDiffRenderer ..> dryRunWarnings
    DefaultCompDiffRenderer ..> dryRunWarnings
    StructuredCompDiffRenderer ..> dryRunWarnings
    dryRunWarnings ..> DryRunInfo
    dryRunWarnings ..> OutputWarning

    StructuredDiffOutput --> Summary
    StructuredDiffOutput --> ChangeDetail
    StructuredDiffOutput --> OutputError
    StructuredDiffOutput --> xrDiffWire
    xrDiffWire --> Summary
    xrDiffWire --> ChangeDetail
    xrDiffWire --> XRStatus
    xrDiffWire --> OutputError
    CompDiffOutput --> CompositionDiff
    CompDiffOutput --> OutputError
    CompDiffOutput --> OutputWarning
    StructuredDiffOutput --> OutputWarning
    CompositionDiff --> AffectedResourcesSummary
    CompositionDiff --> XRImpact
    CompositionDiff --> ResourceDiff
    CompositionDiff --> RevisionImpact
    OutputError --> ResourceValidationFailure
    ResourceValidationFailure --> FieldValidationError
    XRImpact --> XRStatus
    XRImpact --> FilterReason
    DownstreamChanges --> Summary
    DownstreamChanges --> ChangeDetail

    ResourceDiff --> DiffType
    ResourceDiff --> DryRunInfo
    ChangeDetail --> DryRunInfo
    DryRunInfo --> DryRunSkipReason
