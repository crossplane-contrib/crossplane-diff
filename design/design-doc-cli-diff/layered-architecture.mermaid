%%{init: {"flowchart": {"defaultRenderer": "elk"}}}%%
flowchart TD
    subgraph CMDL["Command Layer"]
        CMD[Cmd]
        HELP[Help Function]
    end
    
    subgraph APPL["Application Layer"]
        APP[AppContext]
        DPR[DiffProcessor]
        CDPR[CompDiffProcessor]
        LOAD[Loader]
    end

    subgraph DOML["Domain Layer"]
        subgraph PROC["Processing Components"]
            DIFFCALC[DiffCalculator]
            SCHMVLD[SchemaValidator]
            RESMGR[ResourceManager]
            REQPRV[RequirementsProvider]
            FNPRV[FunctionProvider]
            CMPR[compare.GenerateDiff]
        end

        subgraph REND["Rendering Components"]
            DIFFRND[DiffRenderer]
            CDIFFRND[CompDiffRenderer]
            DIFFFRM[DiffFormatter]
        end

        subgraph RESC["Resource Components"]
            RENDER[Render Function]
        end
    end

    subgraph CLIL["Client Layer"]
        subgraph K8SC["Kubernetes Clients"]
            APPLY[ApplyClient]
            ACCSS[AccessChecker]
            RESRC[ResourceClient]
            SCHMA[SchemaClient]
            TCONV[TypeConverter]
        end

        subgraph XPC["Crossplane Clients"]
            COMP[CompositionClient]
            DEFN[DefinitionClient]
            ENVT[EnvironmentClient]
            FUNC[FunctionClient]
            CRED[CredentialClient]
            TREE[ResourceTreeClient]
            CREV[CompositionRevisionClient]
        end
    end
    
    subgraph EXTL["External Systems"]
        K8S[Kubernetes API]
    end
    
    %% Edges join groups, not components: every component in a group
    %% depends on the same groups below it, and enumerating each pair
    %% adds noise without information.
    CMDL --> APPL
    APPL --> DOML
    %% AppContext constructs every client and injects them into the domain (IoC),
    %% so this one edge covers the Application layer's reach into the Client layer.
    APPL -->|"injects clients"| CLIL
    DOML --> CLIL
    %% Crossplane clients are built on the generic ResourceClient.
    XPC --> K8SC
    CLIL --> EXTL

    %% Styling
    classDef commandLayer fill:#f9d5e5,stroke:#333,stroke-width:1px
    classDef applicationLayer fill:#eeeeee,stroke:#333,stroke-width:1px
    classDef domainLayer fill:#d0f0c0,stroke:#333,stroke-width:1px
    classDef clientLayer fill:#a8e6cf,stroke:#333,stroke-width:1px
    classDef externalSystems fill:#ffd3b6,stroke:#333,stroke-width:1px
    
    class CMD,HELP commandLayer
    class APP,DPR,CDPR,LOAD applicationLayer
    class DIFFCALC,CMPR,SCHMVLD,RESMGR,REQPRV,FNPRV,DIFFRND,CDIFFRND,DIFFFRM,RENDER domainLayer
    class APPLY,ACCSS,RESRC,SCHMA,TCONV,COMP,CREV,DEFN,ENVT,FUNC,CRED,TREE clientLayer
    class K8S externalSystems
